<!DOCTYPE html>
<html>
    <head>
        <title>Test</title>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
            crossorigin=""/>
        <link href="{{ url_for('static', path='/styles.css') }}" rel="stylesheet">
        <link id="favicon" rel="icon" type="image/x-icon" href="{{ url_for('static', path='/favicon.ico') }}">
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

        <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
        <script src="https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6"></script>
        <script src="https://cdn.jsdelivr.net/npm/papaparse@5"></script>
        <script src="https://cdn.jsdelivr.net/npm/split.js@1"></script>
    </head>
    
    <body>
        <body>
        <div id="top">
            <div id="map"></div>
            <div id="table-wrapper">
            <table>
                <thead>
                <tr>
                    <th>Posten</th>
                    <th>km</th>
                    <th>Soll</th>
                    <th>Ist</th>
                    <th>Δ</th>
                    <th>+lkm</th>
                    <th>Dauer</th>
                    <th>↑</th>
                    <th>↓</th>
                </tr>
                </thead>
                <tbody id="tbody"></tbody>
            </table>
            </div>
        </div>
        <div id="profile"></div>
        </body>

        <!--
        <div class="table-wrap">
            
        </div>-->

        <script type="module">
            const track_points = {{ track.points_as_json }}
            const track_segments = {{ track.segments_as_json }}

            const color = '#cc0000'

            let cumDist = 0;
            for (const seg of track_segments) {
                cumDist       += seg.dist / 1000;
                const endPt = track_points[seg.end_idx];
                seg.ele        = endPt.ele;
                seg.cumDist = cumDist;
            }

            const check_points = track_points
                .filter(p => p.name)
                .map(p => ({
                    name: p.name,
                    ele:  p.ele,
                    lat: p.lat,
                    lon: p.lon,
                    cumDist: track_segments[p.seg_idx].cumDist,
                }));            

            // Populate emap
            const map = L.map('map');

            var route = L.polyline(
                track_points.map(p => [p.lat, p.lon]),
                {color: color, opacity: 0.6, weight:5}
            )

            route.addTo(map);

            for (const cp of check_points) {               
                L.circleMarker([cp.lat, cp.lon], {
                    radius: 6, color: color, fillColor: color, fillOpacity: 0.7, weight: 2
                })
                .bindTooltip(cp.name, {permanent: true, direction: 'top', className: 'map-cp-label', opacity: 1})
                .addTo(map);
                
            }

            L.tileLayer('https://wmts.geo.admin.ch/1.0.0/ch.swisstopo.pixelkarte-farbe/default/current/3857/{z}/{x}/{y}.jpeg',
                {
                maxZoom: 18,
                attribution: '&copy; swisstopo'
                }
            ).addTo(map);

            map.fitBounds(route.getBounds())
            
            // Populate height profile plot
            let plot, xScale, yScale;  
            function buildPlot() {
                const div = document.querySelector("#profile");
                if (plot) plot.remove();
                plot = Plot.plot({
                    width:  div.clientWidth,
                    height: div.clientHeight,
                    marks: [
                        //Plot.ruleX(check_points, { x: 'cumDist', stroke: '#aaa', strokeDasharray: '3 2' }),
                        Plot.dot(check_points, { x: 'cumDist', y: 'ele', fill: color, r: 4 }),
                        Plot.text(check_points, { x: 'cumDist', y: 'ele', text: 'name', dy: -20, fontSize: 10, textAnchor: 'middle' }),
                        Plot.areaY(track_segments, { x: 'cumDist', y: 'ele', y2: d3.min(track_segments, d => d.ele), fill: '#8884' }),
                        Plot.lineY(track_segments, { x: 'cumDist', y: 'ele', stroke: color }),
                        Plot.crosshairX(track_segments, { x: 'cumDist', y: 'ele' }),
                        Plot.tip(track_segments, Plot.pointerX({ x: 'cumDist', y: 'ele', title: d => `${d.cumDist.toFixed(1)} km, ${d.ele.toFixed(0)} m` }))
                    ]
                });
                div.append(plot);
                xScale = plot.scale('x');
                yScale = plot.scale('y');
                plot.addEventListener("input", onPlotInput);
            }

            buildPlot();

            let autoPan = true;

            const highlight = L.circleMarker([0, 0], {
                radius: 10, color: color, fillColor: color, fillOpacity: 0.2, weight: 2
            });

            // popolate table
            const tbody = document.getElementById('tbody');
            tbody.innerHTML = '';
            for (const cp of check_points)
            {
                const tr = document.createElement('tr');

                tr.innerHTML = `
                    <td>${cp.name}</td>
                    <td>${cp.cumDist.toFixed(0)}</td>
                `;    
                /*    <td>${toHHMM(cp.soll + start)}</td>
                    <td class="ist-cell ${isMeasured ? 'measured' : 'projected'}">${toHHMM(cp.ist + start)}</td>
                    <td class="delta-cell ${isMeasured ? dCls : 'projected' }">${dText}</td>
                    <td>${segLkm  != null ? '+' + segLkm.toFixed(1) : '—'}</td>
                    <td>${durStr(segDur)}</td>
                    <td class="up">${segAsc  != null ? Math.round(segAsc)  + ' m' : '—'}</td>
                    <td class="down">${segDesc != null ? Math.round(segDesc) + ' m' : '—'}</td>
                `;*/

                tbody.appendChild(tr);
            } 

            // Chart → Map
            function onPlotInput() {
                const d = plot.value;
                if (d) {
                    const center_idx = Math.trunc((d.start_idx + d.end_idx) / 2);
                    const pt = track_points[center_idx];
                    highlight.setLatLng([pt.lat, pt.lon]).addTo(map);
                    if (autoPan && !map.getBounds().contains([pt.lat, pt.lon])) {
                        map.panTo([pt.lat, pt.lon], {animate: true, duration: 2.0});
                    }
                } else {
                    highlight.remove();
                }
            }

            // Map → Chart: synthetic pointer events drive the same crosshair + tip
            xScale = plot.scale('x');
            yScale = plot.scale('y');            

            map.on('mousemove', e => {
                const plotRect = plot.getBoundingClientRect();

                let best = null, bestDist = Infinity;
                for (const d of track_points) {
                    const m = map.distance(e.latlng, [d.lat, d.lon]);
                    if (m < bestDist) { bestDist = m; best = d; }
                }
                let x = plotRect.left;   // SVG x=0, before marginLeft → outside frame
                let y = plotRect.top + plotRect.height / 2;
                if (best && bestDist < 300) {
                    const seg = track_segments[best.seg_idx];
                    x = plotRect.left + xScale.apply(seg.cumDist);
                    y = plotRect.top  + yScale.apply(seg.ele);
                    
                } 

                autoPan = false

                plot.dispatchEvent(new PointerEvent('pointermove', {
                        clientX: x,
                        clientY: y,
                        bubbles: true, pointerId: 1, isPrimary: true,
                    }));

                autoPan = true;
            });


            Split(['#map', '#table-wrapper'], { sizes: [65, 35], gutterSize: 6, onDrag: () => map.invalidateSize(), onDragEnd: () => buildPlot() });
            Split(['#top', '#profile'], { direction: 'vertical', sizes: [80, 20], gutterSize: 6, onDragEnd: () => { map.invalidateSize(); buildPlot(); } });

        </script>
    </body>
<html>